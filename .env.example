# Copy this file to `.env` and fill in the keys. `.env` is gitignored; this
# example is not, so it must never hold a real key.
#
# The harness runs one or two providers depending on AGENT_MODE. Summary is
# fixed: it always runs on the separately configured Smoll provider, the native
# Anthropic Messages wire format, in every mode.
#
#   mid    - plan, spec, tickets, triage, code and review run on the mid block;
#            summary always runs on the smoll block
#   giga   - plan, spec, tickets, triage, code and review run on the giga block;
#            summary always runs on the smoll block
#   hybrid - plan, spec, tickets, triage and review run on the giga block, code
#            runs on the mid block, and summary always runs on the smoll block
#
# A phase is routed by role, not by vendor: the mid provider speaks the
# chat-completions wire format, the giga provider speaks the responses wire
# format, and the smoll provider speaks the Anthropic Messages wire format. Any
# endpoint that speaks the matching format can fill a block.

# ========================================================
# AGENT MODE
# ========================================================
# Unset defaults to `mid`; `hybrid` is the multi-provider example below.
AGENT_MODE=hybrid

# ========================================================
# Mid -- chat-completions wire format (the code phase in hybrid mode)
# ========================================================
LLM_MID_URL=https://api.example.com/v1/chat/completions
LLM_MID_MODEL=your-mid-model
LLM_MID_API_KEY=sk-REPLACE_ME
# LLM_MID_AUTH=none            # use instead of a key for a keyless endpoint
LLM_MID_REASONING_EFFORT=high  # none | low | medium | high | max
# Optional local price metadata in USD per million input tokens. The value
# below is an example, not this model's actual price.
# LLM_MID_INPUT_PRICE_PER_MILLION_USD=1.25

# ========================================================
# Giga -- responses wire format (plan/spec/tickets/triage/review in hybrid mode)
# ========================================================
# Both coordinates are required whenever the mode is giga or hybrid.
LLM_GIGA_URL=https://api.example.com/v1/responses
LLM_GIGA_MODEL=your-giga-model
LLM_GIGA_API_KEY=sk-REPLACE_ME
# LLM_GIGA_AUTH=none           # use instead of a key for a keyless endpoint
LLM_GIGA_REASONING_EFFORT=high # none | low | medium | high | max
# Optional local price metadata in USD per million input tokens. The value
# below is an example, not this model's actual price.
# LLM_GIGA_INPUT_PRICE_PER_MILLION_USD=2.5

# ========================================================
# Smoll -- Anthropic Messages wire format (summary in every mode)
# ========================================================
# The summary pass always uses this block, in mid, giga and hybrid mode. Both
# LLM_SMOLL_MODEL and LLM_SMOLL_API_KEY are required and have no fallback to
# the mid or giga credentials. LLM_SMOLL_URL is optional: unset, empty or
# whitespace-only resolves to the documented Anthropic Messages endpoint below.
LLM_SMOLL_URL=https://api.anthropic.com/v1/messages
LLM_SMOLL_MODEL=your-smoll-model
# Placeholder only -- never put a real key in this tracked example file.
LLM_SMOLL_API_KEY=sk-ant-REPLACE_ME
# Optional local price metadata in USD per million input tokens. The value
# below is an example, not this model's actual price.
# LLM_SMOLL_INPUT_PRICE_PER_MILLION_USD=3.75

# ========================================================
# [INACTIVE] Local LM Studio (the unchanged mid defaults)
# ========================================================
# With LLM_MID_URL and LLM_MID_MODEL unset, the mid block uses these local
# defaults. Set LLM_MID_AUTH=none for keyless local use; LM Studio ignores the
# lm-studio placeholder key.
# LLM_MID_URL=http://192.168.56.1:1234/v1/chat/completions
# LLM_MID_MODEL=local-model
# LLM_MID_API_KEY=lm-studio
# LLM_MID_AUTH=none
