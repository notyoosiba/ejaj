# Configuration for the ignored LLM integration tests (see tests/common/mod.rs).
#
# These tests never read the project `.env` or any `LLM_*` variable: this file is their
# own single source of truth, and a real environment variable overrides it for a live
# check against another provider. Recording is stricter: with `EJAJ_LLM_RECORD=1` an
# override that differs from this file is refused, because the committed fixtures in
# tests/fixtures/ must name the local endpoints (`read_fixture` enforces that too).
# The model must be one the endpoint actually serves -- `local_config` checks
# `/v1/models` and fails with the available ids otherwise.
#
# Override for a different environment without editing this file, for example:
#   EJAJ_TEST_LLM_MODEL=qwen2.5-coder-7b-instruct cargo test -- --ignored --test-threads=1

EJAJ_TEST_LLM_URL=http://192.168.56.1:1234/v1/chat/completions
# The only model in the local catalog that passes all four boundaries (see
# llm-model-sweep.md); the committed fixtures in tests/fixtures/ were recorded
# with it. Re-record with EJAJ_LLM_RECORD=1 (see tests/fixtures/README.md).
EJAJ_TEST_LLM_MODEL=qwen/qwen3-30b-a3b

# The two-provider tests (tests/hybrid_pipeline.rs) need a second endpoint that
# speaks the responses wire format. The local LM Studio endpoint serves that too,
# so a hybrid recording stays local and free. The key falls back to
# EJAJ_TEST_LLM_API_KEY when absent.
EJAJ_TEST_ARCHITECT_URL=http://192.168.56.1:1234/v1/responses
EJAJ_TEST_ARCHITECT_MODEL=qwen/qwen3-30b-a3b
#EJAJ_TEST_ARCHITECT_API_KEY=
